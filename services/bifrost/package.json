{
	"name": "bifrost",
	"version": "0.1.0",
	"description": "Authentication service — registration, login, sessions, and users",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"env:init": "grid-sync-env --services=bifrost",
		"dev": "tsx watch --env-file=.env src/index.ts",
		"build": "tsup",
		"start": "node dist/index.js",
		"admin:promote": "node dist/cli.js promote",
		"admin:demote": "node dist/cli.js demote",
		"lint": "biome check --config-path=../.. .",
		"lint:fix": "biome check --config-path=../.. --write .",
		"format": "biome format --config-path=../.. --write .",
		"test": "vitest run",
		"typecheck": "tsc",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"packageManager": "pnpm@12.6.0",
	"dependencies": {
		"@hono/node-server": "^1.19.11",
		"@hono/zod-openapi": "^1.2.2",
		"@node-rs/argon2": "^2.0.2",
		"@simplewebauthn/server": "^14.0.2",
		"grid": "workspace:*",
		"hono": "^4.12.5",
		"saga": "workspace:*",
		"skuld": "workspace:*",
		"vidar": "workspace:*",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^24.13.6",
		"@types/pg": "^8.11.0",
		"pg": "^8.16.0",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^7.0.2",
		"vali": "workspace:*",
		"vitest": "^5.0.1"
	}
}
