{
	"name": "mimir",
	"version": "0.1.0",
	"description": "App data service: each user's places and visited regions",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"env:init": "grid-sync-env --services=mimir",
		"dev": "tsx watch --env-file=.env src/index.ts",
		"build": "tsup",
		"start": "node dist/index.js",
		"db:migrate": "saga migrate --env-file=.env",
		"db:status": "saga status --env-file=.env",
		"openapi": "vitest run --update src/__tests__/app.test.ts",
		"lint": "biome check --config-path=../.. .",
		"lint:fix": "biome check --config-path=../.. --write .",
		"format": "biome format --config-path=../.. --write .",
		"test": "vitest run",
		"typecheck": "tsc",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"packageManager": "pnpm@12.6.0",
	"dependencies": {
		"@hono/node-server": "^1.19.11",
		"@hono/zod-openapi": "^1.2.2",
		"grid": "workspace:*",
		"hono": "^4.12.5",
		"saga": "workspace:*",
		"skuld": "workspace:*",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@types/node": "^24.13.6",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^7.0.2",
		"vali": "workspace:*",
		"vitest": "^5.0.1"
	}
}
