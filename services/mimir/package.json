{
	"name": "mimir",
	"version": "0.1.0",
	"description": "App data service: each user's places, visited regions and NFL picks",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"env:init": "grid-sync-env --services=mimir",
		"dev": "tsx watch --env-file=.env src/index.ts",
		"build": "tsup",
		"start": "node dist/index.js",
		"db:migrate": "saga migrate --env-file=.env",
		"db:status": "saga status --env-file=.env",
		"openapi": "vitest run --update src/__tests__/app.test.ts",
		"lint": "biome check --config-path=../.. .",
		"lint:fix": "biome check --config-path=../.. --write .",
		"format": "biome format --config-path=../.. --write .",
		"test": "vitest run",
		"typecheck": "tsc",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"packageManager": "pnpm@12.6.0",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1148.0",
		"@aws-sdk/s3-request-presigner": "^3.1148.0",
		"@hono/node-server": "^2.1.1",
		"@hono/zod-openapi": "^1.6.3",
		"grid": "workspace:*",
		"hono": "^4.13.9",
		"saga": "workspace:*",
		"skuld": "workspace:*",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^26.6.2",
		"tsup": "^8.5.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vali": "workspace:*",
		"vitest": "^5.0.1"
	}
}
