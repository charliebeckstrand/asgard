{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": ["tsconfig.base.json", "tsup.config.ts", "biome.json"],
    "tasks": {
        "//#env:init": {
            "cache": false
        },
        "env:init": {
            "cache": false
        },
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "!src/**/__tests__/**", "!src/**/*.test.ts"],
            "outputs": ["dist/**"]
        },
        "dev": {
            "dependsOn": ["^build", "env:init"],
            "cache": false,
            "persistent": true
        },
        "db:migrate": {
            "dependsOn": ["^build", "env:init"],
            "cache": false
        },
        "lint": {},
        "typecheck": {
            "dependsOn": ["^typecheck"]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "test:coverage": {
            "dependsOn": ["^build"],
            "outputs": ["coverage/**"]
        }
    }
}
