{
	"name": "skuld",
	"version": "0.1.0",
	"description": "Shared Zod schemas — reusable primitives, composites, and enums for validation and OpenAPI",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"lint": "biome check --config-path=../.. .",
		"lint:fix": "biome check --config-path=../.. --write .",
		"format": "biome format --config-path=../.. --write .",
		"test": "vitest run",
		"typecheck": "tsc",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"packageManager": "pnpm@10.29.3",
	"dependencies": {
		"@hono/zod-openapi": "^1.2.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@types/node": "^24.13.6",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^7.0.2",
		"vali": "workspace:*",
		"vitest": "^4.0.18"
	}
}
