{
	"name": "vali",
	"version": "0.1.0",
	"description": "Shared test utilities — vitest config, postgres testcontainers, and temp-dir helpers",
	"type": "module",
	"exports": {
		"./fixtures": {
			"types": "./src/fixtures.ts",
			"default": "./dist/fixtures.js"
		},
		"./containers": {
			"types": "./src/containers.ts",
			"default": "./dist/containers.js"
		},
		"./config": {
			"types": "./src/config.ts",
			"default": "./dist/config.js"
		},
		"./env": {
			"types": "./src/env.ts",
			"default": "./dist/env.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"lint": "biome check --config-path=../.. .",
		"lint:fix": "biome check --config-path=../.. --write .",
		"format": "biome format --config-path=../.. --write .",
		"test": "vitest run",
		"typecheck": "tsc",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"packageManager": "pnpm@12.23.0",
	"dependencies": {
		"@testcontainers/postgresql": "^12.2.2",
		"vitest": "^5.1.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@types/node": "^26.6.11",
		"tsup": "^9.0.0",
		"typescript": "^7.0.2"
	}
}
