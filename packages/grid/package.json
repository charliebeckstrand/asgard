{
	"name": "grid",
	"version": "0.1.0",
	"description": "Shared Hono service utilities — middleware, schemas, error handling, and OpenAPI config",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./middleware": {
			"types": "./src/entry/middleware.ts",
			"default": "./dist/middleware.js"
		},
		"./environment": {
			"types": "./src/entry/environment.ts",
			"default": "./dist/environment.js"
		},
		"./manifest": {
			"types": "./src/entry/manifest.ts",
			"default": "./dist/manifest.js"
		},
		"./server-lifecycle": {
			"types": "./src/entry/server-lifecycle.ts",
			"default": "./dist/server-lifecycle.js"
		}
	},
	"bin": {
		"grid-sync-env": "./src/bin/sync-env.ts"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"sync-env": "tsx src/bin/sync-env.ts",
		"lint": "biome check --config-path=../.. .",
		"lint:fix": "biome check --config-path=../.. --write .",
		"format": "biome format --config-path=../.. --write .",
		"test": "vitest run",
		"typecheck": "tsc",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"packageManager": "pnpm@12.23.0",
	"dependencies": {
		"@hono/node-server": "^2.1.11",
		"@hono/swagger-ui": "^0.6.2",
		"@hono/zod-openapi": "^1.6.3",
		"hono": "^4.13.23",
		"pino": "^10.4.0",
		"skuld": "workspace:*",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@types/node": "^26.6.11",
		"tsup": "^9.0.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vali": "workspace:*",
		"vitest": "^5.1.2"
	}
}
