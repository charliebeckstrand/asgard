{
	"name": "saga",
	"version": "0.1.0",
	"description": "Postgres: the client, the sql template, file migrations and the saga CLI",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"bin": {
		"saga": "./bin/saga.js"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"bootstrap": "tsx src/bin/bootstrap.ts",
		"lint": "biome check --config-path=../.. .",
		"lint:fix": "biome check --config-path=../.. --write .",
		"format": "biome format --config-path=../.. --write .",
		"test": "vitest run",
		"typecheck": "tsc",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"packageManager": "pnpm@12.23.0",
	"dependencies": {
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@types/node": "^26.6.11",
		"@types/pg": "^8.23.1",
		"grid": "workspace:*",
		"tsup": "^9.0.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vali": "workspace:*",
		"vitest": "^5.1.2"
	}
}
