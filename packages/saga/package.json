{
	"name": "saga",
	"version": "0.1.0",
	"description": "Data toolkit — Postgres pool, SQL builder, migrations, and structured logging",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./log": {
			"types": "./src/log/index.ts",
			"default": "./dist/log.js"
		}
	},
	"bin": {
		"saga-bootstrap": "./src/bin/bootstrap.ts"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"bootstrap": "tsx src/bin/bootstrap.ts",
		"lint": "biome check --config-path=../.. .",
		"lint:fix": "biome check --config-path=../.. --write .",
		"format": "biome format --config-path=../.. --write .",
		"test": "vitest run",
		"typecheck": "tsc",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"packageManager": "pnpm@12.6.0",
	"dependencies": {
		"pg": "^8.16.0",
		"pino": "^9.5.0",
		"pino-pretty": "^11.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@types/node": "^24.13.6",
		"@types/pg": "^8.11.0",
		"grid": "workspace:*",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^7.0.2",
		"vali": "workspace:*",
		"vitest": "^5.0.1"
	}
}
